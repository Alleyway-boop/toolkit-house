{
  "name": "@toolkit-house/react-components",
  "type": "module",
  "version": "0.0.0",
  "description": "React components library built on ts-utils algorithms and data structures",
  "author": "yuanfang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": "",
  "keywords": [
    "react",
    "components",
    "algorithms",
    "data-structures",
    "visualization",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./sorting": {
      "types": "./dist/sorting/index.d.ts",
      "import": "./dist/sorting/index.mjs",
      "require": "./dist/sorting/index.cjs"
    },
    "./data-structures": {
      "types": "./dist/data-structures/index.d.ts",
      "import": "./dist/data-structures/index.mjs",
      "require": "./dist/data-structures/index.cjs"
    },
    "./algorithm-comparator": {
      "types": "./dist/algorithm-comparator/index.d.ts",
      "import": "./dist/algorithm-comparator/index.mjs",
      "require": "./dist/algorithm-comparator/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.mjs",
      "require": "./dist/ui/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.cjs"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles/index.mjs",
      "require": "./dist/styles/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "unbuild --fail-on-warn false",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "nr build",
    "release": "bumpp && pnpm publish",
    "start": "vite",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter=basic",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@toolkit-house/ts-utils": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-links": "^9.1.20",
    "@storybook/react": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.0.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "autoprefixer": "^10.6.1",
    "bumpp": "10.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^0.12.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "storybook": "^9.1.20",
    "tailwindcss": "^3.4.19",
    "tinyexec": "1.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unbuild": "3.6.1",
    "vite": "7.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
