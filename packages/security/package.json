    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "24.0.8",
    "typescript": "5.8.3",
    "unbuild": "3.5.0",
    "vitest": "3.2.4"
  }
}
