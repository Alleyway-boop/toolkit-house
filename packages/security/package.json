{
  "name": "@toolkit-house/security",
  "version": "0.0.1",
  "type": "module",
  "description": "Security utilities for Toolkit House - key management, encryption, and more",
  "author": "yuanfang",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
